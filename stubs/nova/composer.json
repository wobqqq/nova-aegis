{
    "name": "laravel/nova",
    "description": "Test double of Laravel Nova for the Aegis packages' development; not Laravel Nova",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Nova\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravel\\Nova\\NovaCoreServiceProvider"
            ],
            "aliases": {
                "Nova": "Laravel\\Nova\\Nova"
            }
        }
    }
}
